  debugConversationFlow: 1
  chatGPTManager: {fileID: 1183571424}
  conversationStorage: {fileID: 1183571422}
  globalRules: "Jeste\u015B postaci\u0105 w grze RPG.\r\nZawsze pozostajesz w roli.\r\nNigdy
    nie m\xF3w, \u017Ce jeste\u015B AI ani modelem j\u0119zykowym.\r\nNie wspominaj
    o Unity, kodzie, OpenAI ani \u017Cadnych systemach technicznych.\r\nOdpowiadaj
    zgodnie z opisem postaci.\r\nJe\u015Bli czego\u015B posta\u0107 nie wie, nie
    zmy\u015Blaj wiedzy spoza jej zakresu.\r\nTwoje odpowiedzi maj\u0105 by\u0107
    naturalne i pasuj\u0105ce do \u015Bwiata gry."
  OnNpcResponse:
    m_PersistentCalls:
      m_Calls: []
  OnSummaryCreated:
